{
  "method": "GET",
  "path": "/public/geo/countries",
  "responses": {
    "200": {
      "contentType": "application/json",
      "body": {
        "type": "response",
        "message": "success",
        "payload": {
          "countries": [
            {
              "code": "us",
              "name": "United States"
            },
            {
              "code": "de",
              "name": "Germany"
            }
          ],
          "planType": "residentialbasic"
        },
        "pagination": {}
      }
    },
    "400": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "planType query parameter is required"
      }
    },
    "401": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Missing or invalid Authorization header. Use: Authorization: Bearer qd_live_YOUR_API_KEY"
      }
    },
    "429": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Rate limit exceeded. Resets in 23 minutes.",
        "payload": {
          "rateLimit": 1200,
          "requestCount": 1200,
          "resetAt": "2026-10-07T15:00:00.000Z"
        }
      }
    },
    "500": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Failed to fetch countries. Please try again later."
      }
    }
  }
}
