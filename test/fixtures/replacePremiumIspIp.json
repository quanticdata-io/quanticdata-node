{
  "method": "POST",
  "path": "/public/premium-isp/orders/{orderId}/replacements",
  "responses": {
    "200": {
      "contentType": "application/json",
      "body": {
        "type": "response",
        "message": "IP replaced.",
        "payload": {
          "pending": false,
          "oldIp": "203.0.113.7",
          "newIp": "203.0.113.42",
          "bought": 2,
          "used": 1,
          "checking": 0,
          "left": 1
        },
        "pagination": {}
      }
    },
    "202": {
      "contentType": "application/json",
      "body": {
        "type": "response",
        "message": "Your new IP is being prepared. Do not replace this IP again.",
        "payload": {
          "pending": true,
          "oldIp": "203.0.113.7",
          "newIp": null,
          "bought": 2,
          "used": 0,
          "checking": 1,
          "left": 1
        },
        "pagination": {}
      }
    },
    "400": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Invalid format. Must be one of: markdown, html, text (or data_format markdown/screenshot, format raw)"
      }
    },
    "401": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Missing or invalid Authorization header. Use: Authorization: Bearer qd_live_YOUR_API_KEY"
      }
    },
    "402": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Your balance is too low for this purchase. Top up in the dashboard and try again.",
        "payload": {
          "code": "INSUFFICIENT_BALANCE"
        }
      }
    },
    "403": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Premium ISP needs your own API key. Create one in the dashboard under API keys.",
        "payload": {
          "code": "KEY_REQUIRED"
        }
      }
    },
    "404": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Job not found"
      }
    },
    "409": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "This city is not available right now.",
        "payload": {
          "code": "CITY_UNAVAILABLE"
        }
      }
    },
    "429": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Rate limit exceeded. Resets in 23 minutes.",
        "payload": {
          "rateLimit": 1200,
          "requestCount": 1200,
          "resetAt": "2026-10-07T15:00:00.000Z"
        }
      }
    },
    "502": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "The IP could not be swapped right now. No swap was used.",
        "payload": {
          "code": "REPLACEMENT_REFUSED"
        }
      }
    },
    "503": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Premium ISP is not available through the API yet. Use the dashboard to buy Premium ISP plans.",
        "payload": {
          "code": "PRODUCT_DISABLED"
        }
      }
    }
  }
}
