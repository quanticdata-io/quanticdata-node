{
  "method": "POST",
  "path": "/scraper/extract",
  "responses": {
    "200": {
      "contentType": "application/json",
      "body": {
        "type": "response",
        "message": "Extraction successful",
        "payload": {
          "url": "https://example.com/pricing",
          "finalUrl": "https://example.com/pricing",
          "status": 200,
          "contentType": "text/html; charset=utf-8",
          "format": "markdown",
          "title": "Pricing — Example",
          "metadata": {
            "description": "Simple, transparent pricing.",
            "canonical": "https://example.com/pricing",
            "language": "en"
          },
          "content": "# Pricing\n\nStarter — [amount]/month …",
          "data": {
            "title": "Pricing",
            "price": "[amount]"
          },
          "engine": "tls",
          "attempts": 1,
          "escalated": false,
          "bytes": 48213,
          "durationMs": 1240,
          "geo": {
            "country": "us",
            "state": null,
            "city": null,
            "rotation": "rotating"
          },
          "usage": {
            "cost_usd": 0,
            "free_usd": 0,
            "paid_usd": 0
          }
        },
        "pagination": {}
      }
    },
    "400": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Invalid format. Must be one of: markdown, html, text (or data_format markdown/screenshot, format raw)"
      }
    },
    "401": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Missing or invalid Authorization header. Use: Authorization: Bearer qd_live_YOUR_API_KEY"
      }
    },
    "402": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Your free tier for this month is used up and your balance can't cover this call (estimated [amount]). Add pay-as-you-go credit or pick a plan — your API key stays the same: https://app.quanticdata.io/plans?utm_source=api&utm_medium=402&utm_campaign=free-tier",
        "payload": {
          "code": "INSUFFICIENT_FUNDS",
          "balance": 0,
          "free_remaining": 0,
          "estimated_cost": 0,
          "plans_url": "https://app.quanticdata.io/plans?utm_source=api&utm_medium=402&utm_campaign=free-tier",
          "billing_mode": "free_first"
        }
      }
    },
    "403": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Scraper API is not available: no proxy credentials found. Contact support or purchase a residential, datacenter or IPv6 plan."
      }
    },
    "404": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Preset not found",
        "payload": {
          "url": "https://example.com/"
        }
      }
    },
    "429": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Rate limit exceeded. Resets in 23 minutes.",
        "payload": {
          "rateLimit": 1200,
          "requestCount": 1200,
          "resetAt": "2026-10-07T15:00:00.000Z"
        }
      }
    },
    "500": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Extraction timed out",
        "payload": {
          "url": "https://example.com/"
        }
      }
    },
    "503": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "This API is temporarily unavailable while we finalize pricing. Contact support for early access."
      }
    }
  }
}
