{
  "method": "GET",
  "path": "/public/premium-isp/cities/carriers",
  "responses": {
    "200": {
      "contentType": "application/json",
      "body": {
        "type": "response",
        "message": "Success",
        "payload": {
          "location": "United States - New York City",
          "type": "city",
          "udp": false,
          "maxAgeSeconds": 120,
          "carriers": [
            {
              "asn": 7922,
              "name": "Comcast",
              "stock": 5
            }
          ]
        },
        "pagination": {}
      }
    },
    "400": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Invalid format. Must be one of: markdown, html, text (or data_format markdown/screenshot, format raw)"
      }
    },
    "401": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Missing or invalid Authorization header. Use: Authorization: Bearer qd_live_YOUR_API_KEY"
      }
    },
    "403": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Premium ISP needs your own API key. Create one in the dashboard under API keys.",
        "payload": {
          "code": "KEY_REQUIRED"
        }
      }
    },
    "409": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "This city is not available right now.",
        "payload": {
          "code": "CITY_UNAVAILABLE"
        }
      }
    },
    "429": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Rate limit exceeded. Resets in 23 minutes.",
        "payload": {
          "rateLimit": 1200,
          "requestCount": 1200,
          "resetAt": "2026-10-07T15:00:00.000Z"
        }
      }
    },
    "503": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Premium ISP is not available through the API yet. Use the dashboard to buy Premium ISP plans.",
        "payload": {
          "code": "PRODUCT_DISABLED"
        }
      }
    }
  }
}
