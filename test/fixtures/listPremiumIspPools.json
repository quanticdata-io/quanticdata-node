{
  "method": "GET",
  "path": "/public/premium-isp/pools",
  "responses": {
    "200": {
      "contentType": "application/json",
      "body": {
        "type": "response",
        "message": "Success",
        "payload": {
          "enabled": true,
          "days": 30,
          "currency": "USD",
          "pools": [
            {
              "id": "premium-us-retail",
              "country": "US",
              "countryName": "United States",
              "category": "retail",
              "categoryName": "Retail",
              "name": "Premium United States Retail ISP",
              "description": "Dedicated static IPs optimized for retail websites, with unlimited bandwidth.",
              "days": 30,
              "minQuantity": 1,
              "maxQuantity": 100,
              "available": true,
              "subnet": false,
              "stock": 1591,
              "features": {
                "dedicated": true,
                "unlimitedBandwidth": true,
                "udp": true,
                "maxSpeedGbps": 10,
                "cityChoice": false,
                "carrierChoice": false,
                "replacementWithin24hOnRequest": true,
                "subnetsOnRequest": true
              }
            }
          ]
        },
        "pagination": {}
      }
    },
    "400": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Invalid format. Must be one of: markdown, html, text (or data_format markdown/screenshot, format raw)"
      }
    },
    "401": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Missing or invalid Authorization header. Use: Authorization: Bearer qd_live_YOUR_API_KEY"
      }
    },
    "403": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Premium ISP needs your own API key. Create one in the dashboard under API keys.",
        "payload": {
          "code": "KEY_REQUIRED"
        }
      }
    },
    "429": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Rate limit exceeded. Resets in 23 minutes.",
        "payload": {
          "rateLimit": 1200,
          "requestCount": 1200,
          "resetAt": "2026-10-07T15:00:00.000Z"
        }
      }
    },
    "503": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Premium ISP is not available through the API yet. Use the dashboard to buy Premium ISP plans.",
        "payload": {
          "code": "PRODUCT_DISABLED"
        }
      }
    }
  }
}
