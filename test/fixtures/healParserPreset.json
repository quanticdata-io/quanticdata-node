      "body": {
        "type": "response",
        "message": "Preset healed",
        "payload": {
          "healed": true,
          "reason": "coverage improved",
          "version": 2,
          "coverageBefore": 0.5,
          "coverageAfter": 1,
          "parser": {
            "title": "h1[itemprop=name]",
            "price": "span.price-now"
          },
          "usage": {
