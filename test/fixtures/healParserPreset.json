          "code": "INSUFFICIENT_FUNDS",
          "balance": 0,
          "free_remaining": 0,
          "estimated_cost": 0,
          "plans_url": "https://app.quanticdata.io/plans?utm_source=api&utm_medium=402&utm_campaign=free-tier",
          "billing_mode": "free_first"
        }
      }
