{
  "method": "POST",
  "path": "/public/proxies/{orderId}/rotate",
  "responses": {
    "200": {
      "contentType": "application/json",
      "body": {
        "type": "response",
        "message": "Session rotated. The next request on this proxy string gets a new IP.",
        "payload": {
          "rotated": true,
          "orderId": "ord_8c21",
          "sessionId": "a1b2c3",
          "port": 9999,
          "protocol": "http",
          "rotatedAt": "2026-10-19T14:05:00.000Z",
          "nextAllowedAt": "2026-10-19T14:05:10.000Z"
        },
        "pagination": {}
      }
    },
    "400": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "This is a rotating proxy string: it already gets a new IP on every request. Rotation works on sticky strings (rotation: \"sticky\" in generate).",
        "payload": {
          "code": "SESSION_REQUIRED"
        }
      }
    },
    "401": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Missing or invalid Authorization header. Use: Authorization: Bearer qd_live_YOUR_API_KEY"
      }
    },
    "403": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Rotation needs your own API key. Create one in the dashboard under API keys.",
        "payload": {
          "code": "KEY_REQUIRED"
        }
      }
    },
    "404": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Order not found.",
        "payload": {
          "code": "ORDER_NOT_FOUND"
        }
      }
    },
    "409": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Rotation links are not available for this plan. For a new IP, request a new sticky proxy string with POST /v1/public/proxies/generate: each string has its own session.",
        "payload": {
          "code": "ROTATION_NOT_SUPPORTED",
          "planType": "residentialpremium",
          "reason": "new_string_only"
        }
      }
    },
    "410": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "This plan has expired.",
        "payload": {
          "code": "PLAN_EXPIRED",
          "planType": "residentialbasic"
        }
      }
    },
    "429": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "This session was rotated less than 10 seconds ago. Try again in 7 s.",
        "payload": {
          "code": "RATE_LIMITED",
          "scope": "session",
          "retryAfter": 7
        }
      }
    },
    "502": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "The IP could not be rotated right now. Your proxy string still works. Try again in a few seconds.",
        "payload": {
          "code": "ROTATION_FAILED"
        }
      }
    },
    "503": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Rotation links are temporarily unavailable. Please try again later.",
        "payload": {
          "code": "SERVICE_UNAVAILABLE"
        }
      }
    }
  }
}
