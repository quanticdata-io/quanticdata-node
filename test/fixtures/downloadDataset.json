{
  "method": "GET",
  "path": "/scraper/datasets/{jobId}/download",
  "responses": {
    "200": {
      "contentType": "application/json",
      "body": {
        "columns": [
          {
            "name": "company",
            "type": "string"
          }
        ],
        "rows": [
          {
            "company": "Bologna Rent",
            "_source_url": "https://example.it/contatti"
          }
        ],
        "rowCount": 1
      }
    },
    "400": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Invalid format. Must be one of: markdown, html, text (or data_format markdown/screenshot, format raw)"
      }
    },
    "401": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Missing or invalid Authorization header. Use: Authorization: Bearer qd_live_YOUR_API_KEY"
      }
    },
    "404": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "File not ready — the run has not finished or produced no rows"
      }
    },
    "429": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Rate limit exceeded. Resets in 23 minutes.",
        "payload": {
          "rateLimit": 1200,
          "requestCount": 1200,
          "resetAt": "2026-10-07T15:00:00.000Z"
        }
      }
    },
    "500": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Scraper service unavailable. Please try again later."
      }
    },
    "503": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "This API is temporarily unavailable while we finalize pricing. Contact support for early access."
      }
    }
  }
}
