{
  "method": "POST",
  "path": "/public/ipv6/quote",
  "responses": {
    "200": {
      "contentType": "application/json",
      "body": {
        "type": "response",
        "message": "Success",
        "payload": {
          "speedMbps": 200,
          "days": 7,
          "planName": "IPv6 Unlimited · 200 Mbps · 7 days",
          "trafficMetered": false,
          "vatRate": 0,
          "vat": 0,
          "currency": "USD",
          "paymentMethod": "BALANCE",
          "sufficientBalance": true,
          "reserved": false,
          "quotedAt": "2026-10-20T09:00:00.000Z"
        },
        "pagination": {}
      }
    },
    "400": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "\"days\" must be one of [1, 7, 30]",
        "payload": {
          "code": "VALIDATION_ERROR"
        }
      }
    },
    "401": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Missing or invalid Authorization header. Use: Authorization: Bearer qd_live_YOUR_API_KEY"
      }
    },
    "403": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "IPv6 speed plans need your own API key. Create one in the dashboard under API keys.",
        "payload": {
          "code": "KEY_REQUIRED"
        }
      }
    },
    "409": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "This speed is not sold. Available: 30 Mbps, 60 Mbps, 120 Mbps, 200 Mbps; 1000 Mbps on request.",
        "payload": {
          "code": "SPEED_UNAVAILABLE",
          "speeds": [
            30,
            60,
            120,
            200
          ]
        }
      }
    },
    "429": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "Too many requests. Try again in 21 minutes.",
        "payload": {
          "code": "RATE_LIMITED",
          "retryAfter": 1260
        }
      }
    },
    "503": {
      "contentType": "application/json",
      "body": {
        "type": "error",
        "message": "IPv6 speed plans are not available through the API yet. Use the dashboard to buy them.",
        "payload": {
          "code": "PRODUCT_DISABLED"
        }
      }
    }
  }
}
