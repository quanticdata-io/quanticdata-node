{
  "name": "quanticdata",
  "version": "0.1.0",
  "description": "Official TypeScript/Node.js SDK for the QuanticData API: scrape to Markdown, SERP, map and crawl, batch, Web Unlocker, collectors, datasets and proxy generation.",
  "keywords": [
    "quanticdata",
    "web-scraping",
    "scraping-api",
    "serp-api",
    "crawler",
    "markdown",
    "proxy",
    "residential-proxies",
    "web-unlocker",
    "llm",
    "ai-agents",
    "sdk",
    "typescript"
  ],
  "homepage": "https://quanticdata.io/docs/",
  "bugs": {
    "url": "https://github.com/quanticdata-io/quanticdata-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quanticdata-io/quanticdata-node.git"
  },
  "license": "MIT",
  "author": "QuanticData <hello@quanticdata.io>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "generate": "openapi-typescript openapi/openapi.json -o src/generated/openapi.ts --empty-objects-unknown",
    "sync-openapi": "node scripts/sync-openapi.mjs && npm run generate",
    "check:generated": "node scripts/check-generated.mjs",
    "check:package": "publint && attw --pack . --profile node16",
    "mock": "tsx test/mock-server.ts",
    "examples": "node scripts/run-examples.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "openapi-typescript": "^7.13.0",
    "publint": "^0.3.12",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
